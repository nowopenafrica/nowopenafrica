{
  "name": "nowopen-africa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:all && npm run typecheck && vite build && node scripts/stamp-sw.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "check:events": "node scripts/gen-event-constraint.mjs --check",
    "verify": "npm run typecheck && npm run lint && npm run check:all && npm run test",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && npm run typecheck:server && npm run typecheck:edge",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:migrations": "node scripts/check-migrations.mjs",
    "social:check": "node scripts/social-setup.mjs check",
    "social:deploy": "node scripts/social-setup.mjs deploy",
    "check:placements": "node scripts/check-placement-sql.mjs",
    "check:templates": "node scripts/audit-templates.mjs --check",
    "audit:templates": "node scripts/audit-templates.mjs",
    "check:api-imports": "node scripts/check-api-imports.mjs",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "check:drift": "node scripts/check-schema-drift.mjs",
    "typecheck:edge": "tsc --noEmit -p tsconfig.edge.json",
    "check:phone-auth": "node scripts/check-phone-auth.mjs",
    "check:place-qids": "node scripts/check-place-qids.mjs",
    "sync:self-category": "node scripts/sync-self-category.mjs",
    "check:self-category": "node scripts/sync-self-category.mjs --check",
    "check:wa-link": "node scripts/sync-wa-link.mjs --check",
    "check:edge-syntax": "node scripts/check-edge-syntax.mjs",
    "sync:wa-link": "node scripts/sync-wa-link.mjs",
    "sync:brand-social": "node scripts/sync-brand-social.mjs",
    "check:brand-social": "node scripts/sync-brand-social.mjs --check",
    "check:all": "node scripts/check-all.mjs",
    "verify:quick": "node scripts/verify-quick.mjs",
    "check:query-errors": "node scripts/check-query-errors.mjs",
    "record:query-errors": "node scripts/check-query-errors.mjs --record",
    "opendesign:probe": "node scripts/opendesign-probe.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@vercel/edge": "^1.3.3",
    "fflate": "0.8.3",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.344.0",
    "mp4-muxer": "^5.2.2",
    "pdfjs-dist": "^5.4.149",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^7.18.2",
    "read-excel-file": "9.3.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  },
  "overrides": {
    "worker-f": "0.1.20"
  }
}
