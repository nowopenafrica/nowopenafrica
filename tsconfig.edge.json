{
  /*
   * The Supabase Edge Functions, which nothing typechecked.
   *
   * tsconfig.app.json covers `src`, tsconfig.server.json covers `api` and
   * `middleware.ts`. `supabase/functions` — 18 Deno functions plus the _shared
   * modules every one of them imports — was covered by neither, and Supabase
   * deploys them with esbuild, which strips types rather than checking them.
   *
   * MEASURED COST, 2026-09-15: extract-page called
   * `robotsAllowUrl(groups, url, ua)` where the first parameter is declared
   * `string`, and then tested the returned object with `!`. Both are plain type
   * errors. Both shipped. Together they disabled robots.txt enforcement on the
   * manual extraction tool entirely, and it took driving the deployed UI
   * against a disallowed URL to notice.
   *
   * Scoped to _shared for now: that is where the reusable logic lives, so a
   * type error there propagates to all 18 functions, and it is plain
   * TypeScript with no Deno-only globals. The function entrypoints still need
   * `deno check`, which needs Deno on the machine.
   */
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [],
    // `npm:` specifiers resolve to the copies already in node_modules, so the
    // real Supabase types apply rather than `any`.
    "paths": { "npm:*": ["./node_modules/*"] },
    "baseUrl": ".",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    /*
     * Incremental checking.
     *
     * MEASURED, 2026-10-20: a full check of `src` is 29.3s. With the build
     * info file it is 4.4s when nothing relevant changed — the same work,
     * minus re-reading 1,041 files TypeScript already understands.
     *
     * The file lives under node_modules/.cache, which is already ignored, so
     * it is machine-local and never committed. Deleting it costs one slow
     * run and nothing else; it is a cache, not state.
     */
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo/edge.tsbuildinfo",

    "strict": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["supabase/functions/_shared/**/*.ts"],
  "exclude": ["supabase/functions/_shared/**/*.test.ts"]
}
